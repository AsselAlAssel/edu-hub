# Database (MongoDB)
DATABASE_URL=

# Auth (NextAuth)
SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_DOMAIN=

# Student sign-in (Google OAuth client, redirect URI:
# <domain>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only this email may register (becomes the admin)
ADMIN_EMAIL=

# File storage (Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
NEXT_PUBLIC_FILES_URL=

# Optional: extra image hosts for the image optimizer, comma-separated
IMAGE_HOSTS=

# Optional, legacy: hosts of images uploaded before R2 (Bunny CDN)
NEXT_BUNNYCDN_CDN_HOSTNAME=
NEXT_BUNNYCDN_PULL_ZONE_NAME=

# Bunny Stream (paid-unit videos), server-only: never NEXT_PUBLIC_
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=
